# ── Copy to .env (Docker) or apps/api/.env (local dev) and fill in ──
DB_PASSWORD=change-me
# Local dev only (Docker builds DATABASE_URL itself):
DATABASE_URL=postgresql://tisa:change-me@localhost:5432/tisa_erp
JWT_SECRET=generate-a-long-random-string-here
PORT=4000
# Public URL of this server (used in links) and the web app origin(s) allowed by CORS
PUBLIC_URL=https://erp.tisatech.in
APP_URL=https://erp.tisatech.in
CORS_ORIGINS=https://erp.tisatech.in
# Document number prefix, e.g. TTS/INV/26-27/0001
DOC_PREFIX=TTS
# SMTP for invoices & service reports (leave SMTP_HOST empty in dev → emails are logged, not sent)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=service@tisatech.in
SMTP_PASS=app-password
MAIL_FROM="Tisa Tech Secure <service@tisatech.in>"
# Optional: Expo access token for push notifications (expo.dev → Access tokens)
EXPO_ACCESS_TOKEN=
# First admin created by the seed
SEED_ADMIN_EMAIL=admin@tisatech.in
SEED_ADMIN_PASSWORD=Admin@12345
# Hosted Postgres TLS: "true" (encrypt; default for Supabase URLs), "verify", or "false"
DATABASE_SSL=true
DATABASE_POOL_MAX=10
# Load sample clients/staff/catalogue on start (use true only on a test environment)
SEED_DEMO=false
