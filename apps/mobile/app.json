{
  "expo": {
    "name": "Tisa Field",
    "slug": "tisa-field",
    "scheme": "tisafield",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f3d5e"
    },
    "ios": {
      "bundleIdentifier": "in.tisatech.field",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is stamped on attendance and site photos so the office can verify site visits.",
        "NSCameraUsageDescription": "Take geo-tagged site photos, selfies for attendance and expense receipts.",
        "NSPhotoLibraryUsageDescription": "Attach receipts and photos."
      }
    },
    "android": {
      "package": "in.tisatech.field",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f3d5e"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is stamped on attendance and site photos so the office can verify site visits."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take geo-tagged site photos, selfies for attendance and expense receipts."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0f3d5e"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://tisa-erp-production.up.railway.app",
      "eas": {
        "projectId": "7b19c15d-de5d-4668-92e0-9e9381a4c15f"
      },
      "router": {}
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "owner": "atharvasamant",
    "updates": {
      "url": "https://u.expo.dev/7b19c15d-de5d-4668-92e0-9e9381a4c15f"
    }
  }
}
